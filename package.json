{
  "name": "sahayak-ai-browser",
  "version": "1.0.1",
  "description": "Sahayak - Human-in-the-Loop AI Browser Agent Chrome Extension",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "practice": "node scripts/serve-practice.mjs",
    "package": "node scripts/package-extension.mjs",
    "build:package": "npm run build && npm run package",
    "test": "node --test scripts/test-phase1.mjs scripts/test-groq.mjs scripts/test-phase2.mjs scripts/test-phase3.mjs scripts/test-phase4.mjs"
  },
  "keywords": [
    "chrome-extension",
    "ai-agent",
    "manifest-v3",
    "gemini",
    "hitl"
  ],
  "author": "Hemanpreet Kaur",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
